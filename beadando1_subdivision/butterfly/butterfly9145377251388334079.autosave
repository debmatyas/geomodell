import java.util.HashMap;
import java.util.HashSet;

ArrayList<PVector> vertices;
ArrayList<int[]> faces;

ArrayList<ArrayList<PVector>> levelVertices = new ArrayList<ArrayList<PVector>>();
ArrayList<ArrayList<int[]>> levelFaces = new ArrayList<ArrayList<int[]>>();
int currentLevel = 0;

int renderMode = 0; 
float zoomZ =200;
float move;
float rotX = 0;
float rotY = 0;
float lastMouseX, lastMouseY;

void setup() {
  size(800, 600, P3D);
  move = width / 2;
  surface.setLocation(displayWidth / 2 - width / 2, displayHeight / 2 - height / 2);
  
  hint(ENABLE_DEPTH_TEST); // mélységteszt --> 3D-ben a hátül lévő elemek nem fognak átlászódni az elülsőkön
  
  loadObjFile("beetle.obj"); 
  levelVertices.add(copyVertices(vertices));
  levelFaces.add(copyFaces(faces));
  
  println("Szintek előre számítása...");
  for (int i = 0; i < 3; i++) {
    applySubdivisionAndSmoothing();
    levelVertices.add(copyVertices(vertices));
    levelFaces.add(copyFaces(faces));
  }
  switchLevel(0);
}

void draw() {
  background(20);
  
  pushMatrix();
  translate(move, height / 2, zoomZ);
  rotateX(rotX);
  rotateY(rotY);
  drawModel();
  popMatrix();
  
  drawUI();
}
